# Public build configuration only. NEVER put secrets into VITE_ variables.
# Local dev / custom domain: /
# Project GitHub Pages: /modelvalue-radar/
VITE_BASE_PATH=/

# CLI health check only. Not embedded in the frontend.
# Enable only after reviewing the data source usage rights.
CATALOG_CHECK_ENABLED=false

