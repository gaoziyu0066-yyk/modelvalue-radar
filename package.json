    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:data": "tsx scripts/check-data.ts",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
